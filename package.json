{
  "name": "app-store-screenshots-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "node scripts/with-env.cjs -- \"next dev\"",
    "build": "node scripts/with-env.cjs -- \"next build\"",
    "start": "node scripts/with-env.cjs -- \"node server.js\"",
    "lint": "eslint .",
    "db:generate": "node scripts/with-env.cjs -- \"prisma generate\"",
    "db:deploy": "node scripts/with-env.cjs -- \"prisma migrate deploy\"",
    "db:migrate": "node scripts/with-env.cjs -- \"prisma migrate dev\"",
    "db:push": "node scripts/with-env.cjs -- \"prisma db push\"",
    "db:seed": "node scripts/with-env.cjs -- \"tsx prisma/seed.ts\"",
    "db:studio": "node scripts/with-env.cjs -- \"prisma studio\"",
    "deploy:build": "node scripts/with-env.cjs -- \"prisma migrate deploy && prisma generate && next build\"",
    "plesk:build": "node scripts/with-env.cjs -- \"prisma db push && prisma generate && next build\"",
    "postinstall": "node scripts/with-env.cjs -- \"prisma generate\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^6.19.3",
    "puppeteer": "^24.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
